server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # React Router (client-side routing): always fall back to index.html
    # so deep links / hard refreshes on nested routes don't 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse-proxy API calls to the cinemate-api service.
    # No path in proxy_pass here on purpose: it forwards the request URI
    # unchanged (including the /api prefix), matching the dev proxy in
    # vite.config.ts and what src/api/clients/apiClient.ts expects.
    location /api/ {
        proxy_pass ${API_PROXY_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
